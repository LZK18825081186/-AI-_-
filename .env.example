# ==========================================
# 闲鱼 AI 自动回复系统 - 环境变量配置
# 复制此文件为 .env 后修改
# ==========================================

# --- 必填：AI 模型 ---
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# --- 必填：飞书多维表格凭证 ---
# 从 项目运作说明.md 或你的飞书 Base URL 中获取
FEISHU_BASE_TOKEN=SwZJb2oCPaEkTGs1nKtcLUKTnyd
FEISHU_TABLE_ID=tblizop7uMcAG0TF

# --- 必填：管理后台 ---
ADMIN_USERNAME=your_username
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET_KEY=generate_a_random_string_here

# --- 可选：图片理解模型（LM Studio） ---
# 不填 = 默认使用本机 LM Studio (localhost:1234)
# 远程 = 填入另一台电脑的地址，如 http://192.168.1.100:1234
# LM_STUDIO_URL=http://192.168.1.100:1234

# --- 可选：启动模式 ---
# manual = 每次双击 start.bat 手动启动
# auto   = 开机自启（Windows 开机启动文件夹）
STARTUP_MODE=manual

# --- 自动：CookieCloud（内置容器，无需修改） ---
COOKIE_CLOUD_HOST=http://host.docker.internal:8088
COOKIE_CLOUD_UUID=auto-generated-by-setup
COOKIE_CLOUD_PASSWORD=auto-generated-by-setup
COOKIE_CLOUD_REFRESH_SECONDS=1800
COOKIE_CLOUD_COOKIE_ID=default

# --- 可选：系统配置 ---
# TZ=Asia/Shanghai
# LOG_LEVEL=INFO
# TOKEN_REFRESH_INTERVAL=72000
# TOKEN_RETRY_INTERVAL=7200
