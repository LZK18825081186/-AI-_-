# ==========================================
# 闲鱼 AI 自动回复系统 - 环境变量配置
# 复制此文件为 .env 后修改
# ==========================================

# --- AI 模型 ---
# 仅填写此部署变量不会启用 AI 回复；请在管理后台为默认设置或具体账号保存 API Key 并启用 AI。
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
# 商品图片理解仅使用阿里云百炼 OpenAI-compatible API，不允许本地视觉模型兜底。
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_here
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus
QWEN_TEXT_MODEL=qwen-plus
QWEN_REQUEST_TIMEOUT=60
QWEN_MAX_RETRIES=2
QWEN_MAX_IMAGE_BYTES=4194304
QWEN_MAX_IMAGE_DIMENSION=2048
QWEN_MAX_PRODUCT_IMAGES=6

# --- 必填：飞书多维表格凭证 ---
# 普通 Compose 默认连接宿主机 user_cli 桥接；Linux 生产请改用 .env.linux.example。
FEISHU_AUTH_MODE=user_cli
FEISHU_APP_ID=cli_your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_BASE_TOKEN=your_feishu_base_token
FEISHU_TABLE_ID=your_feishu_table_id
# 权威库存来源：飞书群聊中发布上述 Base 链接的消息
FEISHU_INVENTORY_CHAT_ID=oc_your_inventory_chat_id
FEISHU_INVENTORY_SOURCE_MESSAGE_ID=om_your_inventory_source_message_id
# 桥接服务只读访问令牌，请使用至少 32 字符的高强度随机字符串
FEISHU_INVENTORY_BRIDGE_TOKEN=replace_with_random_token
# 普通 Compose 连接宿主机桥接；Linux 生产由 docker-compose.linux.yml 固定内部服务地址。
FEISHU_INVENTORY_BRIDGE_URL=http://host.docker.internal:8765

# --- 必填：管理后台 ---
ADMIN_USERNAME=your_username
ADMIN_PASSWORD=your_secure_password_here
# 内部回复/外部发消息 API 共用密钥，至少 32 个随机字节；未配置时接口关闭。
XIANYU_MESSAGE_API_KEY=replace_with_random_64_hex

# --- CookieCloud 自动同步闲鱼 Cookie ---
# 需要浏览器插件 + 服务端（localhost:8088）两者同时在运行
# Docker 部署：填写 http://cookiecloud:8088（容器间通信）
# 手动部署：填写 http://localhost:8088（本机直连）
# 如果不用 CookieCloud，可以去管理后台 -> 账号管理 手动粘贴 Cookie
COOKIE_CLOUD_HOST=http://cookiecloud:8088
COOKIE_CLOUD_UUID=my-xianyu
COOKIE_CLOUD_PASSWORD=your_secure_password_here
COOKIE_CLOUD_REFRESH_SECONDS=1800
COOKIE_CLOUD_COOKIE_ID=default

# --- 可选：系统配置 ---
# DB_PATH=/app/data/xianyu_data.db
# AI_CACHE_DIR=/app/data
# TZ=Asia/Shanghai
# LOG_LEVEL=INFO
# 内存值必须自带单位，例如 1536m、1g。
# MEMORY_LIMIT=1536m
# MEMORY_RESERVATION=512m
# CPU_LIMIT=1.50
# TOKEN_REFRESH_INTERVAL=72000
# TOKEN_RETRY_INTERVAL=7200
