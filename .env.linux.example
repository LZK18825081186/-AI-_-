# Linux Mint production deployment. Copy to .env and replace every CHANGE_ME value.

# Prebuilt linux/amd64 image. Publish this image from the development machine or CI.
XIANYU_IMAGE=CHANGE_ME_REGISTRY/xianyu-auto-reply:2026.07.30
# Required only when xianyu-auto-reply-linux-amd64.tar is present.
IMAGE_ARCHIVE_SHA256=
PULL_POLICY=missing

# Web admin. Keep WEB_BIND_ADDRESS=127.0.0.1 unless a firewall/reverse proxy is configured.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
# Internal/external reply API key; generate at least 32 random bytes.
XIANYU_MESSAGE_API_KEY=CHANGE_ME_RANDOM_64_HEX
TOKEN_EXPIRE_TIME=86400
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300
CAPTCHA_GRANT_TTL=300
ITEM_SEARCH_RATE_LIMIT=6
ITEM_SEARCH_RATE_WINDOW=60
ITEM_SEARCH_MAX_CONCURRENCY=1

# Persistent paths. Keep DB_PATH at this container path so app and maintenance share one database.
DB_PATH=/app/data/xianyu_data.db
AI_CACHE_DIR=/app/data

# AI providers. DEEPSEEK_API_KEY is validated by docker-deploy.sh only; customer replies
# require saving and enabling the default/per-account AI settings in the web admin.
# Qwen handles product images through Alibaba Cloud Model Studio; there is no local VL fallback.
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
DASHSCOPE_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-plus
QWEN_TEXT_MODEL=qwen-plus
# Conservative T730 request and image limits.
QWEN_REQUEST_TIMEOUT=60
QWEN_MAX_RETRIES=1
QWEN_MAX_IMAGE_BYTES=3145728
QWEN_MAX_IMAGE_DIMENSION=1600
QWEN_MAX_PRODUCT_IMAGES=4

# Feishu self-built app credentials. Never commit the completed .env file.
FEISHU_AUTH_MODE=bot
FEISHU_APP_ID=CHANGE_ME_FEISHU_APP_ID
FEISHU_APP_SECRET=CHANGE_ME_FEISHU_APP_SECRET
FEISHU_BASE_TOKEN=CHANGE_ME_FEISHU_BASE_TOKEN
FEISHU_TABLE_ID=CHANGE_ME_FEISHU_TABLE_ID
FEISHU_INVENTORY_CHAT_ID=CHANGE_ME_FEISHU_CHAT_ID
FEISHU_INVENTORY_SOURCE_MESSAGE_ID=CHANGE_ME_FEISHU_MESSAGE_ID
FEISHU_INVENTORY_BRIDGE_TOKEN=CHANGE_ME_RANDOM_64_HEX
FEISHU_REQUEST_TIMEOUT=20
FEISHU_MAX_MEDIA_BYTES=52428800

# T730 resource limits.
TZ=Asia/Shanghai
MEMORY_LIMIT=1536m
CPU_LIMIT=1.50
APP_PIDS_LIMIT=256
BRIDGE_MEMORY_LIMIT=256m
BRIDGE_CPU_LIMIT=0.50
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_INTERVAL_SECONDS=60
BACKUP_RETENTION_DAYS=14
MIN_FREE_DISK_BYTES=4294967296
DISK_CHECK_INTERVAL_SECONDS=3600

# CookieCloud is disabled by default. Enable only after verifying the plugin/server pair.
COOKIE_CLOUD_HOST=
COOKIE_CLOUD_UUID=
COOKIE_CLOUD_PASSWORD=
COOKIE_CLOUD_REFRESH_SECONDS=1800
COOKIE_CLOUD_COOKIE_ID=default
